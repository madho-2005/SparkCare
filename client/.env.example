# ========================================================
# SparkCare Frontend Environment Configuration (.env.example)
# ========================================================
# Copy this file to 'client/.env' or 'client/.env.local'
# IMPORTANT: Only public-safe variables (prefixed with VITE_) should be placed in this file.
# NEVER put secret keys or private credentials in frontend environment files.
# ========================================================

# Backend API Base Endpoint URL:
# Local Development: http://localhost:5000/api/v1
# Vercel Production: https://YOUR-DEPLOYED-BACKEND-DOMAIN/api/v1 (set in Vercel Project Settings -> Environment Variables)
VITE_API_BASE_URL=http://localhost:5000/api/v1

VITE_CONTACT_EMAIL=

