# Dependency directories
node_modules/
**/node_modules/

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env
**/.env
**/.env.*
!**/.env.example
!.env.example

# Production build outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Application Logs & Spooling
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server/logs/

# Database dumps, migrations, & backups
backups/
**/backups/
*.dump
*.sql

# User uploads & temporary storage
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep

# IDE, Editor & OS generated files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
