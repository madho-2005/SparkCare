# ========================================================
# SparkCare Backend Environment Configuration (.env.example)
# ========================================================
# Copy this file to 'server/.env' and populate with local/production values.
# NEVER commit the actual '.env' file to version control.
# ========================================================

# Server Configuration
PORT=
NODE_ENV=

# Database Connection URI (e.g. mongodb://localhost:27017/sparkcare)
MONGODB_URI=

# Cryptographic Tokens (Generate using: openssl rand -hex 32)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# CORS Allowed Origins (Comma-separated URLs, e.g. http://localhost:5173,https://your-sparkcare.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SparkCare
SMTP_FROM=

# Administrative Notification Email
ADMIN_NOTIFICATION_EMAIL=

# Manual UPI QR Payment Configuration
UPI_ID=
UPI_NAME=

# Administrative Scripts Configuration (Optional)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
KEEP_EMAILS=
