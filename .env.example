# ========================================================
# SparkCare - Environment Variables Template (.env.example)
# ========================================================
# Copy this file to '.env' in the root or in respective server/client folders.
# Do NOT commit actual secrets or credentials to GitHub.
# ========================================================

# --- BACKEND SERVER CONFIGURATION ---
PORT=
NODE_ENV=
MONGODB_URI=

# --- AUTHENTICATION & SECURITY (JWT) ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ALLOWED_ORIGINS=
LOG_LEVEL=

# --- CLOUDINARY MEDIA STORAGE ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- SMTP EMAIL SERVICE (NODEMAILER) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=

# --- MANUAL UPI / QR PAYMENT CONFIGURATION ---
UPI_ID=
UPI_NAME=

# --- ADMINISTRATIVE & SCRIPTS CONFIGURATION ---
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
KEEP_EMAILS=

# --- FRONTEND CLIENT CONFIGURATION (client/.env) ---
VITE_API_BASE_URL=
VITE_CONTACT_EMAIL=
